# Copie ce fichier en `backend/.env` puis adapte les chemins.

# Port de l'API Express
PORT=4000

# Dossiers à indexer, séparés par des ";"
# Exemples :
#   macOS  : /Volumes/NAS/Films;/Volumes/NAS/Series
#   Linux  : /mnt/nas/films;/mnt/nas/series
#   Windows: \\NAS\Films;D:\Videos\Series   (ou un lecteur réseau monté, ex. Z:\Films)
MEDIA_MOVIES_DIRS=./sample-media/Films
MEDIA_SHOWS_DIRS=./sample-media/Series

# Profondeur max du scan récursif (sécurité contre les boucles de liens)
SCAN_MAX_DEPTH=8

# Ollama (IA locale)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Origine autorisée pour le frontend en dev (Vite)
CORS_ORIGIN=http://localhost:5173
